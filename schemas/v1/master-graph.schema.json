{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev-flow.dev/schemas/v1/master-graph.schema.json",
  "title": "Dev Flow Master Graph",
  "allOf": [
    {"$ref": "https://dev-flow.dev/schemas/v1/graph.schema.json"},
    {
      "type": "object",
      "required": ["handoffReceipts"],
      "properties": {
        "$schema": {"const": "https://dev-flow.dev/schemas/v1/master-graph.schema.json"},
        "graphKind": {"const": "master"},
        "handoffReceipts": {
          "type": "array",
          "items": {"$ref": "https://dev-flow.dev/schemas/v1/handoff-receipt.schema.json"}
        },
        "nodes": {
          "type": "array",
          "items": {
            "allOf": [
              {"$ref": "https://dev-flow.dev/schemas/v1/node.schema.json"},
              {
                "type": "object",
                "properties": {
                  "type": {"enum": ["Requirement", "Task", "Test", "Gate", "Evidence", "Git", "Failure"]}
                }
              }
            ]
          }
        }
      }
    }
  ]
}
